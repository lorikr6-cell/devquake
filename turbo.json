{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["ROOT_DOMAIN", "NODE_ENV"],
  "globalPassThroughEnv": [
    "MAIN_DB_HOST",
    "MAIN_DB_PORT",
    "MAIN_DB_NAME",
    "MAIN_DB_USER",
    "MAIN_DB_PWD",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PWD",
    "MAIL_FROM",
    "PROXYCHECK_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "start": { "cache": false, "persistent": true, "dependsOn": ["build"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "outputs": [] }
  }
}
