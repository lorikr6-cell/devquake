{
  "name": "devquake",
  "private": true,
  "scripts": {
    "registry": "node scripts/generate-registry.mjs",
    "new:plugin": "node scripts/create-plugin.mjs",
    "dev": "pnpm registry && turbo run dev",
    "build": "pnpm registry && turbo run build",
    "start": "turbo run start --filter=@devquake/host",
    "typecheck": "pnpm registry && turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
