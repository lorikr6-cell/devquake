{
  "name": "devquake",
  "private": true,
  "scripts": {
    "registry": "node scripts/generate-registry.mjs",
    "new:plugin": "node scripts/create-plugin.mjs",
    "dev": "pnpm registry && turbo run dev",
    "build": "pnpm registry && turbo run build",
    "start": "turbo run start --filter=@devquake/host",
    "typecheck": "pnpm registry && turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.6.0"
}
