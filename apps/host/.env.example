# Root domain the host app is served on. Plugins are served on <id>.<ROOT_DOMAIN>.
# Local development (works in Chrome/Edge/Firefox without editing the hosts file):
ROOT_DOMAIN=localhost:3000
# Production:
# ROOT_DOMAIN=devquake.com

# MySQL (Hostinger). Production values are set in hPanel -> website -> Environment variables.
# Never commit real values; put them in apps/host/.env.local for local development.
MAIN_DB_NAME=
MAIN_DB_USER=
MAIN_DB_PWD=
# Optional. Default: localhost:3306 (correct when the app runs on Hostinger).
# From your own machine use the Remote MySQL host shown in hPanel -> Databases -> Remote MySQL.
# MAIN_DB_HOST=
# MAIN_DB_PORT=3306

# App databases (ADR 0007): <ID>_DB_NAME / _USER / _PWD per app with `database: true`
# (optional <ID>_DB_HOST / _PORT, default MAIN_DB_HOST / PORT). Without them the app says it is
# being set up.
# SHOPPING_DB_NAME=
# SHOPPING_DB_USER=
# SHOPPING_DB_PWD=
# WORKOUT_DB_NAME=
# WORKOUT_DB_USER=
# WORKOUT_DB_PWD=

# Email (Hostinger mailbox, e.g. contact@devquake.com). Without SMTP_USER/SMTP_PWD, development
# prints emails (incl. sign-in codes) to the server console; production cannot send codes.
SMTP_USER=
SMTP_PWD=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# MAIL_FROM=DevQuake <contact@devquake.com>

# IP location + VPN detection (proxycheck.io). Optional: without a key ~100 lookups/day,
# a free key gives 1,000/day.
# PROXYCHECK_API_KEY=
