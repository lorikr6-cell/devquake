# Root domain the host app is served on. Plugins are served on <id>.<ROOT_DOMAIN>.
# Local development (works in Chrome/Edge/Firefox without editing the hosts file):
ROOT_DOMAIN=localhost:3000
# Production:
# ROOT_DOMAIN=devquake.com

# MySQL (Hostinger). Production values are set in hPanel -> website -> Environment variables.
# Never commit real values; put them in apps/host/.env.local for local development.
MAIN_DB_NAME=
MAIN_DB_USER=
MAIN_DB_PWD=
# Optional. Default: localhost:3306 (correct when the app runs on Hostinger).
# From your own machine use the Remote MySQL host shown in hPanel -> Databases -> Remote MySQL.
# MAIN_DB_HOST=
# MAIN_DB_PORT=3306
